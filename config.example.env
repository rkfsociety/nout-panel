# Скопируйте в config.local.env и при необходимости измените.
# Файл config.local.env создаётся автоматически при install.sh и в Git не попадает.

# Пользователь Linux, от которого работает панель
PANEL_USER=your-user

# Полный путь к каталогу с app.py (клон репозитория)
INSTALL_DIR=/home/your-user/nout-panel

# Порт HTTP (>= 1024, без root)
PANEL_PORT=8765

# Файл логов (install.sh создаёт /var/log/nout-panel.log)
PANEL_LOG_FILE=/var/log/nout-panel.log

# Файловый менеджер: разрешённые каталоги (через :)
PANEL_FILE_ROOTS=/home/your-user:/mnt

# Папка, в которой Cursor Agent правит код (обычно ~/github-pc)
PANEL_AGENT_WORKSPACE=/home/your-user/github-pc

# Опционально: ключ API вместо cursor agent login
# CURSOR_API_KEY=
