[Unit]
Description=Веб-панель домашнего ноута (Nout Panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@PANEL_USER@
Group=@PANEL_USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/python3 @INSTALL_DIR@/app.py
EnvironmentFile=-/etc/nout-panel/env
# Авто-перезапуск после сбоя процесса
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
# Логи приложения — в файл (panel_log.py), не в journal
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
